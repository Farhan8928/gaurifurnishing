# Playwright is a devDependency used only by `npm run viewport-audit`, which is
# run locally. Without this, `npm install` downloads ~150 MB of browser binaries
# on every CI build for a tool CI never invokes — slow, and occasionally the
# reason an install times out.
#
# Developers who want to run the viewport audit should install the browser once:
#   npx playwright install chromium
playwright_skip_browser_download=1
